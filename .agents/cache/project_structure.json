{
  "project": {
    "name": "hmosagent",
    "full_name": "AI Agent HarmonyOS Plugin",
    "version": "1.0.0",
    "description": "Cross-platform AI agent running on HarmonyOS NEXT, with Rust core and ArkTS UI. Supports WASM, Node.js, and Godot plugin deployment.",
    "license": "MIT",
    "author": "ambitiouscat",
    "package_name": "com.example.hmosagent"
  },
  "architecture": {
    "type": "cross_platform_ai_agent",
    "layers": [
      {
        "name": "ArkTS UI Layer",
        "path": "hmosagent/hmos_agent_core/src/main/ets/",
        "language": "ArkTS/ArkUI",
        "role": "Chat UI, settings, message rendering, Markdown viewer, command palette"
      },
      {
        "name": "C++ NAPI Bridge",
        "path": "hmosagent/hmos_agent_core/src/main/cpp/",
        "language": "C++17",
        "role": "Thread-safe ArkTS ↔ Rust bridge via napi_threadsafe_function"
      },
      {
        "name": "Rust Agent Core",
        "path": "rust_core/agent_core/src/",
        "language": "Rust 2021",
        "role": "LLM chat, session management, ReAct loop, RAG/search, MCP tools, file ops"
      }
    ],
    "platforms": ["HarmonyOS NEXT", "Web (WASM)", "Node.js (NAPI)", "Godot (planned)"]
  },
  "modules": {
    "hmosagent": { "type": "HarmonyOS App", "path": "hmosagent/" },
    "entry": { "type": "HAP Entry", "path": "hmosagent/entry/", "cache_level": "L3" },
    "hmos_agent_core_ets": { "type": "ArkTS HAR Core", "path": "hmosagent/hmos_agent_core/src/main/ets/", "cache_level": "L4" },
    "hmos_agent_core_cpp": { "type": "C++ NAPI Bridge", "path": "hmosagent/hmos_agent_core/src/main/cpp/", "cache_level": "L3" },
    "rust_agent_core": { "type": "Rust Crate", "path": "rust_core/agent_core/", "cache_level": "L4" },
    "scripts": { "type": "Build Orchestration", "path": "scripts/", "cache_level": "L2" }
  },
  "entry_points": {
    "harmonyos": "hmosagent/entry/src/main/ets/entryability/EntryAbility.ets",
    "harmonyos_page": "hmosagent/entry/src/main/ets/pages/Index.ets",
    "rust_lib": "rust_core/agent_core/src/lib.rs",
    "rust_ffi": "rust_core/agent_core/src/ffi.rs",
    "build": "scripts/build-all.sh"
  },
  "build_systems": {
    "harmonyos": { "tool": "Hvigor", "sdk": "6.0.2(22)", "compat_sdk": "5.0.0(12)", "devices": ["phone", "2in1"] },
    "rust": { "tool": "Cargo", "edition": "2021", "cross_compile": "OHOS NDK via WSL2" },
    "native": { "tool": "CMake+Ninja", "output": "libnative_bridge.so" }
  },
  "cache_metadata": {
    "created": "2026-05-27",
    "last_updated": "2026-05-27",
    "scan_type": "full",
    "version": "1.0"
  }
}
